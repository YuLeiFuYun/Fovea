{
  "schemaVersion": 1,
  "planID": "FOVEA-ASYNCIMAGE-LAB-V1",
  "status": "preregistered-before-formal-results",
  "comparator": {
    "name": "Apple AsyncImage",
    "sourceIdentity": "platform-build",
    "requiredBindings": ["xcodeBuild", "osBuild", "deviceProfileID"]
  },
  "applicability": "Benchmarks/AsyncImageLab/applicability.json",
  "workloads": {
    "W1-SCROLL-V1": {
      "cacheStates": ["uncontrolled-system-cache"],
      "primaryEndpoints": ["main-thread-hitch-time", "peak-dirty-memory"],
      "secondaryEndpoints": ["success-count", "failure-count", "origin-request-count", "origin-stopped-count"],
      "hardChecks": ["no-crash-or-hang", "stale-success-zero"]
    },
    "W2-HERO-V1": {
      "cacheStates": ["uncontrolled-system-cache"],
      "primaryEndpoints": ["hero-display-latency", "peak-dirty-memory"],
      "secondaryEndpoints": ["main-thread-hitch-time", "origin-delivered-bytes"],
      "hardChecks": ["all-three-heroes-reach-success-phase"]
    },
    "W10-SWIFTUI-IDENTITY-CHURN-V1": {
      "cacheStates": ["uncontrolled-system-cache"],
      "primaryEndpoints": ["stale-success-count", "visible-success-latency", "main-thread-hitch-time"],
      "secondaryEndpoints": ["phase-failure-count", "origin-request-count", "origin-stopped-count", "peak-dirty-memory"],
      "hardChecks": ["stale-success-zero", "no-crash-or-hang"]
    }
  },
  "execution": {
    "simulatorRuns": 1,
    "formalPhysicalRepetitions": 20,
    "thermalStateRequiredAtStart": "nominal",
    "cacheControl": "not-exposed-by-AsyncImage; report system state and never label cold/warm as controlled",
    "networkProfile": "NET-LOCAL-V1",
    "W1TimeScaleForSimulator": 0.1,
    "W10IdentityChanges": 256,
    "W10IntervalMilliseconds": 16
  },
  "outcomePolicy": {
    "simulator": "functional-and-calibration-only",
    "missingMetric": "not-comparable-not-zero",
    "releaseClaimRequiresPhysicalStableOS": true,
    "noCrossSurfaceRanking": true
  }
}
