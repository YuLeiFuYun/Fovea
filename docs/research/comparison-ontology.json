  "semanticDimensions": [
    {
      "id": "outputQuality",
      "comparisonRule": "相同参考像素、尺寸、alpha 与允许误差"
    },
    {
      "id": "durability",
      "comparisonRule": "相同 D0-D5 持久化等级"
    },
    {
      "id": "securityIsolation",
      "comparisonRule": "相同 namespace、凭证、Vary、redirect 与 no-store 约束"
    },
    {
      "id": "cachePolicy",
      "comparisonRule": "相同缓存层、冷暖状态、freshness 与容量预算"
    },
    {
      "id": "targetGeometry",
      "comparisonRule": "相同 point/pixel 目标、scale、content mode 与向上量化约束"
    },
    {
      "id": "colorManagement",
      "comparisonRule": "相同 EXIF、ICC、色域、HDR 与 alpha 处理"
    },
    {
      "id": "cancellation",
      "comparisonRule": "相同订阅者取消与底层工作停止语义"
    },
    {
      "id": "requestIdentity",
      "comparisonRule": "共享键覆盖相同资源、命名空间、代际、变换与解码配置"
    },
    {
      "id": "resourceBounds",
      "comparisonRule": "相同并发、像素、内存、磁盘和临时文件上界"
    },
    {
      "id": "lifecycle",
      "comparisonRule": "相同可见区间、复用、消失和重新绑定语义"
    },
    {
      "id": "privacy",
      "comparisonRule": "相同诊断字段、脱敏和持久化限制"
    }
  ],
  "claimStates": [
    "proven-in-finite-model",
