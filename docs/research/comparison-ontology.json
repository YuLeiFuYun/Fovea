    "capability-gap",
    "invalid-evidence"
  ],
  "rules": {
    "rankingPrecondition": "all-hard-correctness-and-semantic-profile-equivalence",
    "crossRuntime": "architecture-and-portable-mechanism-by-default; component-performance-only-on-one-device-and-one-contract",
    "missingMetric": "not-comparable-never-zero",
    "unsupportedCapability": "capability-gap-never-silent-exclusion",
    "aggregateScore": "forbidden-for-best-claim"
  }
