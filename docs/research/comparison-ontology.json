  "systemClasses": [
    {
      "id": "platform-baseline",
      "description": "Apple 平台原生 URL、解码、缓存或 UI 基线，只在绑定的 OS/设备上解释。",
      "directEndToEndRanking": true
    },
    {
      "id": "client-pipeline",
      "description": "从请求到可显示图像的客户端网络图片管线。",
      "directEndToEndRanking": true
    },
    {
      "id": "portable-mechanism",
      "description": "请求合并、调度、准入、淘汰、keying 或预取等可迁移机制。",
      "directEndToEndRanking": false
    },
    {
      "id": "cache-system",
      "description": "内存、磁盘或混合缓存实现；只在语义等级一致时直接比较。",
      "directEndToEndRanking": false
    },
    {
      "id": "codec-engine",
      "description": "图像探测、解码、编码或变换引擎；要求相同输出质量契约。",
      "directEndToEndRanking": false
    },
    {
      "id": "algorithm-simulator",
      "description": "离线 trace、oracle 或算法模拟器，不参与客户端端到端排名。",
      "directEndToEndRanking": false
    },
    {
      "id": "adjacent-system",
      "description": "服务端处理、浏览器、CDN、数据库或其他相邻系统，只贡献挑战与设计。",
      "directEndToEndRanking": false
    }
