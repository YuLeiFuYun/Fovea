{
  "coreQuestion": "Can Fovea close ordinary-image warm-disk latency without surrendering exact pixels, cold-path behavior, storage efficiency, security, or cancellation semantics?",
  "decision": {
    "nextStep": "Run preregistered clean-source W2/W11 with the package-only opt-in path, display-ready latency, logical and allocated cache bytes, creation CPU, total physical written bytes and observed reuse. Alias-aware persistent-byte eviction and a restart-durable logical write-window gate are now implemented; calibrate that logical gate against physical write amplification, fixed-window burst behavior, large-store reopen cost and device evidence before considering public or default admission.",
    "rejectedAlternatives": [
      "direct image(for:) benchmark surface fork",
      "unconditional first-hit derived persistence",
      "single globally fixed PNG or LZFSE format"
    ],
    "status": "bounded-package-opt-in-integrated-default-disabled"
  },
