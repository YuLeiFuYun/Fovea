{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fovea.invalid/schemas/auth-gallery-smoke-artifact.schema.json",
  "title": "Fovea W3 Auth Gallery Smoke Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workloadID",
    "profileID",
    "generatedAt",
    "platform",
    "architecture",
    "operatingSystem",
    "verifiedCommit",
    "cases",
    "diagnostics",
    "summary"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workloadID": { "const": "W3-Auth-Gallery-Smoke" },
    "profileID": { "const": "W3-AUTH-GALLERY-SMOKE-V1" },
    "generatedAt": { "type": "string" },
    "platform": { "type": "string", "minLength": 1 },
    "architecture": { "type": "string", "minLength": 1 },
    "operatingSystem": { "type": "string", "minLength": 1 },
    "verifiedCommit": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identifier", "passed", "detail"],
        "properties": {
          "identifier": { "type": "string", "minLength": 1 },
          "passed": { "const": true },
          "detail": { "type": "string" }
        }
      }
    },
    "diagnostics": { "type": "array", "minItems": 1 },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "crossAccountPixelLeakCount",
        "crossAccountMetadataCouplingCount",
        "noStoreReusableWriteCount",
        "logoutResidueCount",
        "crossOriginAuthorizationLeakCount",
        "revokedCommitResidueCount",
        "sensitiveDiagnosticLeakCount",
        "networkRequestCount"
      ],
      "properties": {
        "crossAccountPixelLeakCount": { "const": 0 },
        "crossAccountMetadataCouplingCount": { "const": 0 },
        "noStoreReusableWriteCount": { "const": 0 },
        "logoutResidueCount": { "const": 0 },
        "crossOriginAuthorizationLeakCount": { "const": 0 },
        "revokedCommitResidueCount": { "const": 0 },
        "sensitiveDiagnosticLeakCount": { "const": 0 },
        "networkRequestCount": { "type": "integer", "minimum": 5 }
      }
    }
  }
}
