{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fovea.invalid/schemas/production-coverage.schema.json",
  "title": "Fovea Production Coverage Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "verifiedCommit",
    "verifiedTree",
    "includesWorkingTreeChanges",
    "scope",
    "includedFileCount",
    "totals",
    "modules",
    "files",
    "moduleLineThresholds",
    "criticalFileLineThresholds",
    "nontrivialFileLineFloor",
    "uncoveredFunctions",
    "status",
    "failedMetrics",
    "failedModules",
    "failedFiles"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "verifiedCommit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "verifiedTree": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "includesWorkingTreeChanges": { "type": "boolean" },
    "scope": { "type": "string", "minLength": 1 },
    "includedFileCount": { "type": "integer", "minimum": 1 },
    "totals": { "type": "object" },
    "modules": { "type": "object" },
    "files": { "type": "object" },
    "moduleLineThresholds": { "type": "object" },
    "criticalFileLineThresholds": { "type": "object" },
    "nontrivialFileLineFloor": { "type": "object" },
    "uncoveredFunctions": { "type": "array" },
    "status": { "enum": ["passed", "failed"] },
    "failedMetrics": { "type": "array" },
    "failedModules": { "type": "array" },
    "failedFiles": { "type": "array" }
  }
}
