{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fovea.invalid/schemas/rollback-report.schema.json",
  "title": "Fovea Rollback Verification Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "baseCommit",
    "headCommit",
    "status",
    "checks",
    "log",
    "logDigest"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string" },
    "baseCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
    "headCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
    "status": { "const": "pass" },
    "checks": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "exitCode"],
        "properties": {
          "id": { "enum": ["surface", "format", "tests", "release"] },
          "exitCode": { "const": 0 }
        }
      }
    },
    "log": { "type": "string", "minLength": 1 },
    "logDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
